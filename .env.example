# MyWineApp — variabili d'ambiente
# Copia questo file in ".env.local" e incolla lì i valori veri.
# ".env.local" NON va mai nel repository né in chat. Gli stessi valori vanno
# poi inseriti in Vercel → Project → Settings → Environment Variables.

# ── Supabase (dashboard → Project Settings → API) ─────────────────────────
# Queste due arrivano anche al browser: sono pubbliche e protette dalla RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Questa è segreta: solo lato server. Scavalca la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Chi può entrare ─────────────────────────────────────────────────────
# Email abilitate ad accedere (ricevono il codice a 6 cifre), separate da virgola.
EMAIL_AUTORIZZATE=
# Come si entra: vuoto = link nell'email (funziona col piano gratuito di Supabase).
# "1" = codice a 6 cifre: richiede di poter modificare il modello dell'email (SMTP proprio).
ACCESSO_CON_CODICE=

# ── Catene di provider: nomi separati da virgola, nell'ordine di prova ───
AI_ETICHETTA=gemini,groq,openrouter
AI_TESTO=groq,gemini,openrouter
AI_TRASCRIZIONE=groq,gemini
RICERCA_PREZZO=tavily,exa,scraping

# ── Chiavi dei provider (tutte segrete, solo lato server) ────────────────
# Basta averne una per compito per partire; le altre fanno da riserva.
# Groq      → https://console.groq.com/keys          (etichette, testo, vocale)
GROQ_API_KEY=
# Gemini    → https://aistudio.google.com/apikey     (etichette, testo, vocale) — chiave NUOVA, non quella del vecchio script
GEMINI_API_KEY=
# OpenRouter→ https://openrouter.ai/keys             (riserva, modelli ":free")
OPENROUTER_API_KEY=
# Tavily    → https://app.tavily.com                 (ricerca prezzi)
TAVILY_API_KEY=
# Exa       → https://dashboard.exa.ai/api-keys      (riserva ricerca prezzi)
EXA_API_KEY=

# ── Cron quotidiano ──────────────────────────────────────────────────────
# Stringa casuale lunga: la route del cron risponde solo a chi la presenta.
CRON_SECRET=

# ── Posta per l'accesso (Gmail) ──────────────────────────────────────────
# Con questi due valori l'app spedisce da sola l'email con il codice di accesso,
# senza passare dalla posta di Supabase. La password è una "password per le app"
# di Google (16 lettere, senza spazi): https://myaccount.google.com/apppasswords
GMAIL_UTENTE=
GMAIL_PASSWORD_APP=
